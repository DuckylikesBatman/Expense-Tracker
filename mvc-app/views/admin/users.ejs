<%- include('../partials/header') %>
<% let activePage = 'admin' %>
<%- include('../partials/navbar') %>

<main class="main-content">
  <div class="page-header">
    <div>
      <a href="/admin" class="back-link">&larr; Admin Dashboard</a>
      <h1>Manage Users</h1>
      <p class="page-subtitle">
        <% if (filters.search || filters.role) { %>
          <%= users.length %> result<%= users.length !== 1 ? 's' : '' %> found
        <% } else { %>
          Total: <%= users.length %> users
        <% } %>
      </p>
    </div>
  </div>

  <%- include('../partials/flash') %>

  <div class="card filter-form">
    <form method="GET" action="/admin/users">
      <div class="filter-row">
        <div class="form-group" style="flex:1;min-width:180px">
          <label>Search</label>
          <input
            type="text"
            name="search"
            class="form-input"
            placeholder="Name or email…"
            value="<%= filters.search %>"
          >
        </div>
        <div class="form-group" style="min-width:140px">
          <label>Role</label>
          <select name="role" class="form-input form-select">
            <option value="">All roles</option>
            <option value="user"       <%= filters.role === 'user'       ? 'selected' : '' %>>User</option>
            <option value="admin"      <%= filters.role === 'admin'      ? 'selected' : '' %>>Admin</option>
            <option value="superadmin" <%= filters.role === 'superadmin' ? 'selected' : '' %>>Superadmin</option>
          </select>
        </div>
        <div class="filter-actions">
          <button type="submit" class="btn btn-primary btn-sm">Filter</button>
          <a href="/admin/users" class="btn btn-secondary btn-sm">Clear</a>
        </div>
      </div>
    </form>
  </div>

  <div class="card">
    <table class="table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Role</th>
          <th>Joined</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(u => { %>
          <%
            const isSelf = u._id.toString() === user._id.toString();
            const targetIsSuperadmin = u.role === 'superadmin';
            const targetIsAdmin = u.role === 'admin';
            const viewerIsSuperadmin = user.role === 'superadmin';
            // Admins can only act on regular users; superadmins can act on admins but not other superadmins
            const canEdit = !isSelf && !targetIsSuperadmin && (viewerIsSuperadmin || (!targetIsAdmin));
            const canDelete = !isSelf && !targetIsSuperadmin && (viewerIsSuperadmin || (!targetIsAdmin));
          %>
          <tr>
            <td><%= u.name %></td>
            <td><%= u.email %></td>
            <td><span class="role-badge role-<%= u.role %>"><%= u.role %></span></td>
            <td><%= new Date(u.createdAt).toLocaleDateString() %></td>
            <td class="action-cell">
              <% if (isSelf) { %>
                <span class="hint">(you)</span>
              <% } else if (canEdit || canDelete) { %>
                <% if (canEdit) { %>
                  <a href="/admin/users/<%= u._id %>/edit" class="btn btn-sm btn-outline">Edit</a>
                <% } %>
                <% if (canDelete) { %>
                  <form action="/admin/users/<%= u._id %>?_method=DELETE" method="POST" style="display:inline" onsubmit="return confirm('Delete user <%= u.name %>?')">
                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                  </form>
                <% } %>
              <% } else { %>
                <span class="hint">—</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</main>

<%- include('../partials/footer') %>
