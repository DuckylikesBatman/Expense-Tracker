<nav class="navbar" id="mainNavbar">
  <a class="nav-brand" href="/expenses">💰 ABC</a>
  <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation">&#9776;</button>
  <div class="nav-links" id="navLinks">
    <a href="/dashboard" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'nav-active' : '' %>">Dashboard</a>
    <a href="/expenses" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'expenses' ? 'nav-active' : '' %>">Expenses</a>
    <a href="/categories" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'categories' ? 'nav-active' : '' %>">Categories</a>
    <a href="/budgets" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'budgets' ? 'nav-active' : '' %>">Budgets</a>
    <a href="/income" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'income' ? 'nav-active' : '' %>">Income</a>
    <a href="/settings" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'settings' ? 'nav-active' : '' %>">Settings</a>
    <% if (user && (user.role === 'admin' || user.role === 'superadmin')) { %>
      <a href="/admin" class="nav-link admin-link <%= typeof activePage !== 'undefined' && activePage === 'admin' ? 'nav-active' : '' %>">Admin</a>
    <% } %>
  </div>
  <% if (user) { %>
  <div class="nav-user" id="navUser">
    <div class="nav-user-info">
      <span class="nav-name">👤 <%= user.name %></span>
      <span class="role-badge role-<%= user.role %>"><%= user.role %></span>
    </div>
    <a href="/auth/logout" class="btn btn-sm btn-outline">Logout</a>
  </div>
  <% } %>
</nav>
