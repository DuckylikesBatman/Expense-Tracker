<%- include('../partials/header') %>
<% let activePage = 'income' %>
<%- include('../partials/navbar') %>

<main class="main-content">
  <div class="page-header">
    <div>
      <a href="/income" class="back-link">&larr; Back to Income</a>
      <h1>Edit Income Entry</h1>
    </div>
  </div>

  <%- include('../partials/flash') %>

  <div class="form-card card">
    <form action="/income/<%= entry._id %>?_method=PUT" method="POST" class="form">
      <div class="form-row">
        <div class="form-group">
          <label for="amount">Amount ($) <span class="required">*</span></label>
          <input type="number" id="amount" name="amount" class="form-input" value="<%= entry.amount %>" min="0.01" step="0.01" required />
        </div>
        <div class="form-group">
          <label for="date">Date <span class="required">*</span></label>
          <input type="date" id="date" name="date" class="form-input" value="<%= new Date(entry.date).toISOString().split('T')[0] %>" required />
        </div>
      </div>
      <div class="form-group">
        <label for="source">Source</label>
        <select id="source" name="source" class="form-input form-select">
          <% sources.forEach(s => { %>
            <option value="<%= s %>" <%= entry.source === s ? 'selected' : '' %>><%= s.charAt(0).toUpperCase() + s.slice(1).replace('-', ' ') %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label for="description">Description <span class="hint">(optional)</span></label>
        <input type="text" id="description" name="description" class="form-input" value="<%= entry.description || '' %>" maxlength="200" />
      </div>
      <div class="form-actions">
        <a href="/income" class="btn btn-outline">Cancel</a>
        <button type="submit" class="btn btn-primary">Save Changes</button>
      </div>
    </form>
  </div>
</main>

<%- include('../partials/footer') %>
