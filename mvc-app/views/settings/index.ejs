<%- include('../partials/header') %>
<% let activePage = 'settings' %>
<%- include('../partials/navbar') %>

<main class="main-content">
  <div class="page-header">
    <div>
      <h1>Settings</h1>
      <p class="page-subtitle">Manage your account preferences</p>
    </div>
  </div>

  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

  <div class="settings-grid">

    <!-- Monthly Income -->
    <div class="card settings-card">
      <div class="settings-section-title">💰 Monthly Income</div>
      <p class="settings-desc">Set your income so the expense dashboard shows how much you have left this month.</p>
      <form action="/settings" method="POST" class="form" style="margin-top:20px">
        <div class="form-group">
          <label for="monthlyIncome">Monthly Income ($)</label>
          <input type="number" id="monthlyIncome" name="monthlyIncome" class="form-input"
            placeholder="e.g. 3000" value="<%= user.monthlyIncome || '' %>" min="0" step="0.01" required />
          <span class="hint">Enter your total monthly income or allowance</span>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Save Income</button>
        </div>
      </form>
    </div>

    <!-- Account Stats -->
    <div class="card settings-card">
      <div class="settings-section-title">📊 Account Overview</div>
      <p class="settings-desc">A snapshot of your activity on Expense Tracker.</p>
      <div class="settings-info-grid" style="margin-top:20px">
        <div class="settings-info-item">
          <span class="detail-label">Name</span>
          <span class="detail-value"><%= user.name %></span>
        </div>
        <div class="settings-info-item">
          <span class="detail-label">Email</span>
          <span class="detail-value"><%= user.email %></span>
        </div>
        <div class="settings-info-item">
          <span class="detail-label">Role</span>
          <span class="role-badge role-<%= user.role %>"><%= user.role %></span>
        </div>
        <div class="settings-info-item">
          <span class="detail-label">Member Since</span>
          <span class="detail-value"><%= new Date(user.createdAt).toLocaleDateString('en-US', { year:'numeric', month:'long', day:'numeric' }) %></span>
        </div>
        <% if (stats) { %>
        <div class="settings-info-item">
          <span class="detail-label">Total Expenses</span>
          <span class="detail-value" style="color:#a78bfa;font-weight:700"><%= stats.expenseCount %> expense<%= stats.expenseCount !== 1 ? 's' : '' %></span>
        </div>
        <div class="settings-info-item">
          <span class="detail-label">Total Spent (All Time)</span>
          <span class="detail-value" style="color:#f87171;font-weight:700">$<%= stats.totalSpent.toFixed(2) %></span>
        </div>
        <div class="settings-info-item">
          <span class="detail-label">Active Budgets</span>
          <span class="detail-value" style="color:#6af1d2;font-weight:700"><%= stats.budgetCount %> budget<%= stats.budgetCount !== 1 ? 's' : '' %></span>
        </div>
        <div class="settings-info-item">
          <span class="detail-label">Monthly Income</span>
          <span class="detail-value" style="color:#a78bfa;font-weight:700">
            <% if (user.monthlyIncome > 0) { %>$<%= user.monthlyIncome.toFixed(2) %><% } else { %>Not set<% } %>
          </span>
        </div>
        <% } %>
      </div>
    </div>

    <!-- Change Name -->
    <div class="card settings-card">
      <div class="settings-section-title">✏️ Change Display Name</div>
      <p class="settings-desc">Update the name shown in the navbar and across the app.</p>
      <form action="/settings/profile" method="POST" class="form" style="margin-top:20px">
        <div class="form-group">
          <label for="name">Display Name</label>
          <input type="text" id="name" name="name" class="form-input"
            value="<%= user.name %>" minlength="2" maxlength="50" required />
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Update Name</button>
        </div>
      </form>
    </div>

    <!-- Change Password -->
    <div class="card settings-card">
      <div class="settings-section-title">🔒 Change Password</div>
      <p class="settings-desc">Choose a strong password. You'll need to enter your current password to confirm.</p>
      <form action="/settings/password" method="POST" class="form" style="margin-top:20px">
        <div class="form-group">
          <label for="currentPassword">Current Password</label>
          <input type="password" id="currentPassword" name="currentPassword" class="form-input" placeholder="Enter current password" required />
        </div>
        <div class="form-group">
          <label for="newPassword">New Password</label>
          <input type="password" id="newPassword" name="newPassword" class="form-input" placeholder="Min. 6 characters" minlength="6" required />
        </div>
        <div class="form-group">
          <label for="confirmPassword">Confirm New Password</label>
          <input type="password" id="confirmPassword" name="confirmPassword" class="form-input" placeholder="Repeat new password" required />
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Change Password</button>
        </div>
      </form>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
